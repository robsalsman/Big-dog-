# ── Big Dog configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill it in. `.env` is gitignored.

# ── Brain: which LLM backend powers your clone ──────────────────────────
# These are just DEFAULTS — you can also pick the backend and paste your key
# right in the app (⚙ Settings tab), no .env editing needed.
#
# auto      = Claude if a Claude key is set, else ChatGPT, else local Ollama
# anthropic = always Claude        (needs ANTHROPIC_API_KEY)
# openai    = always ChatGPT       (needs OPENAI_API_KEY)
# ollama    = always local Ollama  (zero API cost, fully offline)
BIGDOG_PROVIDER=auto

# --- Claude (cloud, best quality; powers web research/prospecting) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
BIGDOG_MODEL=claude-opus-4-8

# --- ChatGPT (cloud) ---
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Ollama (local, no API cost) ---
# Install from https://ollama.com, then e.g.  `ollama pull llama3.1`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Web dashboard port.
PORT=4137

# Dashboard password. Protects the whole app (inbox, deals, sending). You can
# also set/change it in-app under ⚙ Settings → Security. Leave blank to run open
# on a trusted local machine. STRONGLY recommended if you expose Big Dog beyond
# localhost — and put it behind HTTPS if you do.
BIGDOG_PASSWORD=

# How often (in minutes) Big Dog checks your mailboxes. 0 disables auto-sync.
BIGDOG_SYNC_MINUTES=5

# What hour (0-23, local time) the morning "What's up, Big Dog!?" digest fires.
BIGDOG_DIGEST_HOUR=7

# Auto-send replies Big Dog is highly confident about, or always hold for your
# one-click approval. Start with "hold".  Options: hold | auto
BIGDOG_SEND_MODE=hold

# Auto-draft a reply the moment a hot/warm email lands, so one's always waiting
# for your approval (inspired by cloudflare/agentic-inbox). Options: on | off
BIGDOG_AUTODRAFT=on

# ── Operator mode + follow-up cadences ──────────────────────────────────
# A deal with no activity for this many days gets a follow-up nudge drafted.
BIGDOG_CADENCE_STALE_DAYS=4
# Max tool steps Big Dog takes per autonomous "operator mode" task.
BIGDOG_AGENT_MAX_STEPS=8

# ── Calendar: Cal.com (open-source scheduling) ──────────────────────────
# Use Cal.com cloud or your own self-hosted instance
# (https://github.com/calcom/cal.com). Big Dog pulls your bookings into the
# unified calendar and shares your booking link when it sets up a call.
#   - API key: Cal.com → Settings → Developer → API Keys
#   - Self-hosted: point CALCOM_BASE_URL at your instance's v1 API
#   - CALCOM_BOOKING_URL is your public link, e.g. https://cal.com/rob
CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com/v1
CALCOM_BOOKING_URL=

# ── Lead generation / prospecting (ZoomInfo-style) ──────────────────────
# How Big Dog sources new leads:
#   web    = free, no signup — uses Claude web access to find from public data
#   apollo = opt-in free-tier API (https://apollo.io) for structured B2B search
#   auto   = use Apollo if APOLLO_API_KEY is set, else web
BIGDOG_PROSPECT_PROVIDER=auto
# Apollo.io API key (free tier). Apollo → Settings → API.
APOLLO_API_KEY=

# ── Chat with Big Dog from Telegram and/or Slack ────────────────────────
# Telegram (easiest for local use — no public URL needed):
#   1. Message @BotFather, /newbot, copy the token below.
#   2. (Optional) set TELEGRAM_CHAT_ID to get the morning brief pushed to you.
#      DM your bot, then check https://api.telegram.org/bot<token>/getUpdates
#      for chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack two-way chat (Socket Mode — also no public URL):
#   - Create an app, enable Socket Mode, add a bot token (xoxb-) with
#     chat:write + app_mentions:read + im:history, and an app token (xapp-)
#     with connections:write. Subscribe to app_mention and message.im events.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
# Or, for one-way notifications only, an Incoming Webhook URL:
SLACK_WEBHOOK_URL=
